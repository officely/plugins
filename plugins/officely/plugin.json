{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "officely",
  "version": "0.3.1",
  "description": "Book desks and meeting rooms, see who's in the office, and manage your workplace in Officely.",
  "author": {
    "name": "Officely",
    "email": "support@officely.app",
    "url": "https://officely.app"
  },
  "homepage": "https://docs.officely.app/building/codex-plugin",
  "repository": "https://github.com/officely/plugins",
  "keywords": ["officely", "workplace", "bookings", "people"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Officely",
        "shortDescription": "Book desks and manage offices",
        "longDescription": "Officely is an enterprise workplace management platform. Ask about your offices the way you'd ask a colleague: book desks and meeting rooms, see who's in the office, and manage your workplace.",
        "developerName": "Officely",
        "category": "Business & Operations",
        "capabilities": ["Read", "Write"],
        "websiteURL": "https://officely.app",
        "supportURL": "https://docs.officely.app/building/support",
        "privacyPolicyURL": "https://trust.officely.app/privacy-policy",
        "termsOfServiceURL": "https://trust.officely.app/terms-of-service",
        "defaultPrompt": [
          "Find a desk for my next office day.",
          "Set up booking approvals for my team.",
          "Help me organise the desks and rooms in my office."
        ],
        "brandColor": "#7BDFFF",
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}
